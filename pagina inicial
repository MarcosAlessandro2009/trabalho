<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Best trip</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            font-family: sans-serif;
            background: #f5f5f5;
        }

        header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo img {
            width: 150px;
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: black;
            font-size: 18px;
            padding: 20px 20px 20px 20px;
            white-space: nowrap;
            background:#dbdbdb;
        }

        .nav-linksalt{

        }

        .nav-linksalt a{
            
        }

        .search {
            margin: 20px auto;
            max-width: 400px;
            padding: 0 20px;
        }

        .search input {
            width: 100%;
            padding: 16px 10px;
            font-size: 16px;
            background: #fff;
            color: #111827;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        .icons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 20px;
        }

        .icons a img {
            max-width: 100px;
            height: auto;
        }

        @media (max-width: 768px) {
            .nav-links {
                flex-direction: column;
                align-items: flex-start;
            }

            .nav-links a {
                font-size: 16px;
                padding: 8px 0;
            }

            .logo {
                margin-bottom: 10px;
            }
        }

        @media (max-width: 480px) {
            .search input {
                font-size: 14px;
                padding: 12px 8px;
            }

            .icons a img {
                max-width: 80px;
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">
            <img src="https://i.imgur.com/hMzFr1n.png" alt="Logo">
        </div>
        
        <nav class="nav-linksalt">
            <a href="">ajuda</a>
            <a href="">minhas viagens</a>
            <a href="">decole conosco</a>
        </nav>

        <nav class="nav-links">
            <a href="">
                <img src="https://fv5-5.files.fm/thumb_show.php?i=bvfggtawaz&view&v=1&PHPSESSID=14846441969e5620a7604684417775abbec38d18" alt="menu" width="30">
            </a>
        </nav>
    </header>

    <div class="search" role="search">
        <input type="text" placeholder="adicione sua localização" aria-label="adicione sua localização"/>
    </div>

    <div class="icons">
        <a href="">
            <img src="" alt="Posto mais próximo">
        </a>
        <a href="">
            <img src="" alt="Próxima parada">
        </a>
        <a href="">
            <img src="" alt="Gps">
        </a>
        <a href="">
            <img src="https://as1.ftcdn.net/jpg/04/22/85/60/1000_F_422856099_L2hiIEpkf5KvGMOZnh3uPggMmcMhMM9X.jpg" alt="Radar">
        </a>
    </div>

</body>
</html>

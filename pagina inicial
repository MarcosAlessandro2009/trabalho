<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Best trip</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: "Arial", sans-serif;
      background: #fff;
      color: #000;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
    }

    .logo img {
      width: 100px;
    }

    nav {
      display: flex;
      background: #dbdbdb;
      border-radius: 5px;
      overflow: hidden;
      align-items: center;
    }

    nav a {
      text-decoration: none;
      color: #333;
      font-size: 16px;
      padding: 12px 25px;
      border-right: 1px solid #bbb;
    }

    nav a:first-child {
      background: #e7e7e7;
    }

    nav a:last-of-type {
      border-right: none;
    }

    .menu-icon {
      padding: 10px 15px;
    }

    .menu-icon img {
      width: 24px;
    }

    .search {
      text-align: center;
      margin: 10px 0 25px;
    }

    .search input {
      width: 320px;
      padding: 12px 12px 12px 38px;
      font-size: 15px;
      border: 1px solid #ccc;
      border-radius: 4px;
      background: #fff url("https://img.icons8.com/color/48/marker.png") no-repeat 10px center;
      background-size: 20px;
    }

    .icons {
      display: flex;
      justify-content: space-around;
      text-align: center;
      padding: 10px 15px 20px;
    }

    .icons div {
      flex: 1;
    }

    .icons img {
      width: 40px;
      margin-bottom: 5px;
    }

    .icons p {
      margin: 0;
      font-size: 13px;
      font-weight: bold;
      line-height: 1.3;
    }

    .divider {
      border: none;
      border-top: 4px solid #007c91;
      margin: 0 0 20px;
    }

    .passeios {
      display: flex;
      justify-content: space-around;
      padding: 0 15px 25px;
      gap: 15px;
    }

    .passeios div {
      flex: 1;
      position: relative;
      border-radius: 6px;
      overflow: hidden;
    }

    .passeios img {
      width: 100%;
      height: 120px;
      object-fit: cover;
      display: block;
    }

    .passeios span {
      position: absolute;
      bottom: 10px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 15px;
      font-weight: bold;
      color: #fff;
      text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
    }

    @media (max-width: 768px) {
      .passeios {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">
      <img src="https://i.imgur.com/hMzFr1n.png" alt="Logo Best Trip">
    </div>

    <nav>
      <a href="#">ajuda</a>
      <a href="#">minhas viagens</a>
      <a href="#">decole conosco</a>
      <div class="menu-icon">
        <img src="https://img.icons8.com/ios-filled/50/000000/menu.png" alt="menu">
      </div>
    </nav>
  </header>

  <div class="search">
    <input type="text" placeholder="adicione sua localização">
  </div>

  <div class="icons">
    <div>
      <img src="https://img.icons8.com/ios-filled/50/car.png" alt="Posto mais próximo">
      <p>posto mais<br>próximo</p>
    </div>
    <div>
      <img src="https://img.icons8.com/ios-filled/50/home.png" alt="Próxima parada">
      <p>próxima<br>parada</p>
    </div>
    <div>
      <img src="https://img.icons8.com/ios-filled/50/marker.png" alt="GPS">
      <p>gps</p>
    </div>
    <div>
      <img src="https://img.icons8.com/ios-filled/50/radar.png" alt="Radar">
      <p>radar</p>
    </div>
    <div>
      <img src="https://img.icons8.com/ios-filled/50/policeman-male.png" alt="Polícia">
      <p>policia<br>corpo de bombeiros</p>
    </div>
  </div>

  <hr class="divider">

  <div class="passeios">
    <div>
      <img src="https://nxboats.com.br/wp-content/uploads/2024/04/casamento-na-lancha.jpg" alt="Romântico">
      <span>passeio romântico</span>
    </div>
    <div>
      <img src="https://blog.assistentedeviagem.com.br/wp-content/uploads/2023/09/tour-gastronomico-.jpg" alt="Gastronômico">
      <span>passeio gastronômico</span>
    </div>
    <div>
      <img src="https://eliteresorts.com.br/blog/wp-content/uploads/os-melhores-lugares-para-viagem-em-famlia.jpg" alt="Família">
      <span>passeio em família</span>
    </div>
    <div>
      <img src="https://ddrio.com/wp-content/uploads/2025/01/foto_fim_de_tarde_visto_num_passeio_da_ddrio-1200x675.jpg" alt="Turístico">
      <span>passeio turístico</span>
    </div>
  </div>

</body>
</html>
